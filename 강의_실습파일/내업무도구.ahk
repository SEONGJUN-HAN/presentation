; ============================================================
;  내 업무 도구 (런처 + 상용구)  — 실습용
; ------------------------------------------------------------
;  이 파일 하나만 실행해두면, 아래 세 가지가 모두 됩니다.
;    1) Ctrl + Alt + L : 나만의 런처 창 (자주 쓰는 것 실행)
;    2) /tel, /mail    : 짧은 단어를 내용으로 자동 변환 (핫스트링)
;    3) /hi · Ctrl+Alt+1~3 : 한글 상용구를 클립보드로 붙여넣기
;
;  ※ 맨 아래 4번은 Click·Sleep·MsgBox 실습 3종 (줄별 주석, Ctrl+Q 로 토글).
;
;  바꿀 곳은 전부 "여기만 바꾸세요" 로 표시해 두었습니다.
; ============================================================

#NoEnv
#SingleInstance, force


; ============================================================
;  1. 런처 : Ctrl + Alt + L 을 누르면 창이 뜹니다
; ============================================================
^!l::
    Gui, Destroy
    Gui, +AlwaysOnTop
    Gui, Font, s12, 맑은 고딕
    Gui, Add, Text, , 원하는 버튼을 누르세요

    ; ▼▼▼ 여기만 바꾸세요 (버튼 이름) ▼▼▼
    Gui, Add, Button, w260 gRun1, 📄 업무일지 열기
    Gui, Add, Button, w260 gRun2, 🌐 나이스 접속
    Gui, Add, Button, w260 gRun3, 📁 올해 업무 폴더
    Gui, Add, Button, w260 gRun4, ✉️ 메일 쓰기
    ; ▲▲▲ 여기까지 ▲▲▲

    Gui, Show, , 나만의 런처
return

; ▼▼▼ 여기만 바꾸세요 (버튼을 누르면 열 대상) ▼▼▼
Run1:
    Gui, Destroy
    Run, C:\Users\내이름\Documents\업무일지.xlsx
return
Run2:
    Gui, Destroy
    Run, https://www.neis.go.kr
return
Run3:
    Gui, Destroy
    Run, C:\Users\내이름\Documents\2026_업무
return
Run4:
    Gui, Destroy
    Run, mailto:
return
; ▲▲▲ 여기까지 ▲▲▲

; 런처 창의 X 버튼을 누르면 창만 닫기 (스크립트는 계속 대기)
GuiClose:
    Gui, Destroy
return


; ============================================================
;  2. 상용구(핫스트링) 기본 : /단어 를 치면 → 내용으로 자동 변환
; ------------------------------------------------------------
;  전화번호·이메일처럼 '영문·숫자'는 이렇게 간단히 하면 됩니다.
;  (긴 한글 문장은 아래 3번 '클립보드' 방식을 쓰세요 → 안 깨짐)
; ============================================================
; ▼▼▼ 여기만 바꾸세요 (왼쪽=칠 단어, 오른쪽=나올 내용) ▼▼▼
::/tel::063-123-4567
::/mail::admin@school.kr
; ▲▲▲ 여기까지 ▲▲▲


; ============================================================
;  3. 클립보드로 붙여넣기 : 한글 상용구는 이렇게!
; ------------------------------------------------------------
;  한글을 2번 방식(그냥 타이핑)으로 길게 내보내면 IME 때문에
;  글자가 깨질 수 있습니다(세→8 처럼). 그래서 한글은
;  '클립보드에 담아 붙여넣기(^v)'가 안전합니다.
; ============================================================

; ── (3-a) 단어로 트리거 : /hi, /sign ──
; ▼▼▼ 여기만 바꾸세요 ▼▼▼
::/hi::
    Clipboard := "안녕하세요. 이리고등학교 행정실 홍길동입니다."
    Send, ^v
Return

; 여러 줄은  `n  으로 줄바꿈 (역따옴표 + n)
::/sign::
    Clipboard := "홍길동 | 행정실`n☎ 063-000-0000`n✉ hong@korea.kr"
    Send, ^v
Return
; ▲▲▲ 여기까지 ▲▲▲

; ── (3-b) 단축키로 트리거 : Ctrl + Alt + 1~3 ──
;   (Ctrl+숫자는 브라우저 탭 전환과 겹쳐서 Alt 까지 함께 누릅니다)
; ▼▼▼ 여기만 바꾸세요 ▼▼▼
^!1::
    Clipboard := "○○은행 123-456-789 홍길동"    ; ← 자주 붙여넣는 문구
    Send, ^v
return

^!2::
    Clipboard := "늘 감사드립니다. 오늘도 좋은 하루 보내세요."
    Send, ^v
return

^!3::
    Clipboard := "확인 후 회신드리겠습니다."
    Send, ^v
return
; ▲▲▲ 여기까지 ▲▲▲


; ============================================================
;  4. (실습용) Click · Sleep · MsgBox — 하나씩 따로 연습
; ------------------------------------------------------------
;  각 실습의 코드 줄이 맨 앞 ; 로 주석 처리돼 있어 지금은 꺼져 있습니다.
;   ▶ 켜기 : 그 실습의 "코드 줄"만 마우스로 선택 → Ctrl + Q → F5
;   ▶ 끄기 : 같은 줄을 다시 선택 → Ctrl + Q
;  (Ctrl + Q = 선택한 줄들 주석/해제 토글. 한 번에 하나씩만 켜세요.)
;
;  ※ 좌표 찾기(WindowSpy) : 계산기를 미리 켜 두고, WindowSpy 를 실행해
;    버튼 위에 마우스를 올리면 화면 좌표(X, Y)가 실시간으로 보입니다.
;    Click 은 이 좌표가 필요합니다.
; ============================================================


; ── 실습 1) 클릭 한 번 : Ctrl + Alt + C ──
;   계산기를 켜 두고, WindowSpy 로 숫자 버튼 좌표를 확인해 아래를 바꾸세요.
;   (아래 4줄을 선택 → Ctrl + Q)
;^!c::
;    CoordMode, Mouse, Screen     ; WindowSpy 와 같은 화면 좌표계
;    Click, 200 300               ; ← 여기만 바꾸세요 (숫자 버튼 좌표)
;return


; ── 실습 2) 슬립 넣고 클릭 두 번 : Ctrl + Alt + X ──
;   버튼 두 개를 순서대로 누릅니다. 사이의 Sleep 을 늘렸다 줄였다 해보세요.
;   (아래 5줄을 선택 → Ctrl + Q)
;^!x::
;    CoordMode, Mouse, Screen
;    Click, 200 300               ; ← 첫 번째 버튼 좌표 (예: 숫자 1)
;    Sleep, 1000                  ; 1초 기다림  ← 숫자를 바꿔보기 (0 으로도!)
;    Click, 250 300               ; ← 두 번째 버튼 좌표 (예: + )
;return


; ── 실습 3) 메시지 박스 : Ctrl + Alt + M ──
;   화면에 알림창을 띄웁니다. 자동화 중간 확인(디버깅)에 씁니다.
;   (아래 3줄을 선택 → Ctrl + Q)
;^!m::
;    MsgBox, 안녕하세요! 이것이 알림창입니다.
;return
