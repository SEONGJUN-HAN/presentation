; ============================================================
;  나만의 업무 런처  (내업무도구.ahk)
; ------------------------------------------------------------
;  Ctrl + Alt + L 을 누르면 런처 창이 뜹니다.
;  버튼으로 자주 쓰는 파일·사이트·폴더를 열고,
;  상용구(/tel, /hi)와 빠른 붙여넣기(Ctrl+Alt+1~3)도 함께 삽니다.
;
;  ★ 슬라이드의 [N단계] = 이 파일의 [N단계] 주석 위치입니다.
;  ★ 바꿀 곳은 전부 "▼ 여기만 바꾸세요" 로 표시되어 있습니다.
; ============================================================

#NoEnv
#SingleInstance, force


; ============================================================
;  [0단계] 워밍업 : Ctrl + Alt + M → 내 첫 알림창
; ------------------------------------------------------------
;  F5로 실행하고 Ctrl + Alt + M 을 눌러 알림창이 뜨면 성공!
;  문구를 바꿔 다시 실행해 보고, 확인했으면 지워도 됩니다.
;  (MsgBox는 아래 ❓ 도움말 버튼에서 다시 만납니다)
; ============================================================
^!m::
    MsgBox, 반갑습니다! 첫 스크립트 성공!
Return


; ============================================================
;  [1단계] 맛보기 단축키 : 단축키 + Run 한 줄이면 뭐든 열립니다
; ------------------------------------------------------------
;  ^ = Ctrl, ! = Alt, + = Shift, # = Win
; ============================================================
^!n::
    Run, https://www.neis.go.kr        ; Ctrl+Alt+N → 나이스
Return


; ============================================================
;  [2단계] 런처 창 : Ctrl + Alt + L → 버튼 모음 창이 뜹니다
; ============================================================
^!l::
    Gui, Destroy
    Gui, +AlwaysOnTop
    Gui, Font, s13 bold, 맑은 고딕
    Gui, Add, Text, w260 Center, 🚀 나만의 업무 런처
    Gui, Font, s11 norm, 맑은 고딕

    ; ▼▼▼ [3단계] 여기만 바꾸세요 ① — 버튼 이름 ▼▼▼
    Gui, Add, Button, w260 h36 gRun1, 📄 업무일지 열기
    Gui, Add, Button, w260 h36 gRun2, 🌐 나이스 접속
    Gui, Add, Button, w260 h36 gRun3, 📁 올해 업무 폴더
    Gui, Add, Button, w260 h36 gRun4, ✉️ 메일 쓰기
    ; ▲▲▲ 여기까지 ▲▲▲

    ; [6단계] 일하는 버튼 — 여는 게 아니라 '작업'을 해주는 버튼
    Gui, Add, Button, w260 h36 gMacro1, 📝 메모장 열고 할 일 쓰기

    ; [0단계] 도움말 버튼 — 워밍업 때 배운 MsgBox 재활용
    Gui, Add, Button, w260 h32 gHelp, ❓ 단축키 도움말
    Gui, Add, Button, w260 h32 gLauncherClose, ❌ 닫기

    Gui, Show, , 나만의 런처
Return


; ------------------------------------------------------------
;  [3단계] ▼▼▼ 여기만 바꾸세요 ② — 버튼이 여는 대상 ▼▼▼
;  (경로 따는 법: 파일을 Shift + 우클릭 → "경로로 복사")
; ------------------------------------------------------------
Run1:
    Gui, Destroy
    Run, C:\Users\내이름\Documents\업무일지.xlsx
Return

Run2:
    Gui, Destroy
    Run, https://www.neis.go.kr
Return

Run3:
    Gui, Destroy
    Run, C:\Users\내이름\Documents\2026_업무
Return

Run4:
    Gui, Destroy
    Run, mailto:
Return
; ▲▲▲ 여기까지 ▲▲▲


; ------------------------------------------------------------
;  [6단계] 일하는 버튼의 속내용 : Sleep + Send
;  프로그램을 열고 → 뜰 때까지 기다렸다가 → 대신 입력해 줍니다.
; ------------------------------------------------------------
Macro1:
    Gui, Destroy
    Run, notepad.exe
    Sleep, 1000                        ; 메모장이 뜰 때까지 1초 대기 (0으로 바꿔 실험!)
    Clipboard := "📌 오늘 할 일`n1. `n2. `n3. "
    Send, ^v                           ; 한글은 클립보드로! (5단계에서 배운 방법)
Return


; ------------------------------------------------------------
;  [0단계] 도움말 버튼의 속내용 : MsgBox
; ------------------------------------------------------------
Help:
    Gui, Destroy
    MsgBox, 단축키 안내`n`nCtrl+Alt+L : 런처 열기`nCtrl+Alt+N : 나이스 바로가기`n/tel /mail /hi /sign : 상용구`nCtrl+Alt+1~3 : 빠른 붙여넣기
Return

; 런처 창의 X 버튼·닫기 버튼 (스크립트는 계속 대기)
LauncherClose:
GuiClose:
    Gui, Destroy
Return


; ============================================================
;  [4단계] 상용구(핫스트링) : /단어 를 치면 내용으로 자동 변환
; ------------------------------------------------------------
;  전화번호·이메일처럼 '영문·숫자'는 이렇게 간단히 됩니다.
; ============================================================
; ▼▼▼ 여기만 바꾸세요 (왼쪽=칠 단어, 오른쪽=나올 내용) ▼▼▼
::/tel::063-123-4567
::/mail::admin@school.kr
; ▲▲▲ 여기까지 ▲▲▲


; ============================================================
;  [5단계] 한글 상용구는 클립보드로!
; ------------------------------------------------------------
;  한글을 4단계 방식으로 내보내면 IME 때문에 글자가 깨질 수
;  있습니다(세→8 처럼). 한글은 '클립보드에 담아 ^v'가 안전합니다.
; ============================================================
; ▼▼▼ 여기만 바꾸세요 ▼▼▼
::/hi::
    Clipboard := "안녕하세요. 이리고등학교 행정실 홍길동입니다."
    Send, ^v
Return

; 여러 줄은  `n  으로 줄바꿈 (역따옴표 + n)
::/sign::
    Clipboard := "홍길동 | 행정실`n☎ 063-000-0000`n✉ hong@korea.kr"
    Send, ^v
Return

; 단축키로도 붙여넣기 : Ctrl + Alt + 1~3
^!1::
    Clipboard := "○○은행 123-456-789 홍길동"
    Send, ^v
Return

^!2::
    Clipboard := "늘 감사드립니다. 오늘도 좋은 하루 보내세요."
    Send, ^v
Return

^!3::
    Clipboard := "확인 후 회신드리겠습니다."
    Send, ^v
Return
; ▲▲▲ 여기까지 ▲▲▲


; ============================================================
;  [보너스] 좌표 클릭 : WindowSpy + Click
; ------------------------------------------------------------
;  코드 줄이 ; 로 주석 처리돼 있어 지금은 꺼져 있습니다.
;   ▶ 켜기 : 코드 줄만 선택 → Ctrl + Q → F5   ▶ 끄기 : 다시 Ctrl + Q
;  계산기를 켜 두고, WindowSpy(SciTE 메뉴 Tools → Spy)로
;  버튼 위 화면 좌표(X, Y)를 확인해 아래 숫자를 바꾸세요.
; ============================================================

; ── 클릭 한 번 : Ctrl + Alt + C ──  (아래 4줄 선택 → Ctrl + Q)
;^!c::
;    CoordMode, Mouse, Screen     ; WindowSpy 와 같은 화면 좌표계
;    Click, 200 300               ; ← 여기만 바꾸세요 (버튼 좌표)
;return

; ── 슬립 넣고 클릭 두 번 : Ctrl + Alt + X ──  (아래 5줄 선택 → Ctrl + Q)
;^!x::
;    CoordMode, Mouse, Screen
;    Click, 200 300               ; ← 첫 번째 버튼 좌표
;    Sleep, 1000                  ; 사이 대기 (숫자를 바꿔 실험)
;    Click, 250 300               ; ← 두 번째 버튼 좌표
;return
